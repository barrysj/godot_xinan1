{"frames": [{"duration": 0.9, "texture": ExtResource("idle")}, {"duration": 0.9, "texture": ExtResource("anticipation")}, {"duration": 0.9, "texture": ExtResource("anticipation")}, {"duration": 1.1, "texture": ExtResource("impact")}, {"duration": 1.1, "texture": ExtResource("recover")}, {"duration": 1.1, "texture": ExtResource("idle")}], "loop": false, "name": &"ranged", "speed": 12},
{"frames": [{"duration": 0.9, "texture": ExtResource("idle")}, {"duration": 0.9, "texture": ExtResource("anticipation")}, {"duration": 0.9, "texture": ExtResource("cast")}, {"duration": 1.1, "texture": ExtResource("cast")}, {"duration": 1.1, "texture": ExtResource("recover")}, {"duration": 1.1, "texture": ExtResource("idle")}], "loop": false, "name": &"cast", "speed": 12},
