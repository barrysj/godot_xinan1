{"frames": [{"duration": 1.0, "texture": SubResource("idle")}, {"duration": 1.0, "texture": SubResource("anticipation")}, {"duration": 1.0, "texture": SubResource("release")}, {"duration": 1.0, "texture": SubResource("anticipation")}, {"duration": 1.0, "texture": SubResource("idle")}], "loop": false, "name": &"melee", "speed": 8.0},
{"frames": [{"duration": 1.0, "texture": SubResource("idle")}, {"duration": 1.0, "texture": SubResource("anticipation")}, {"duration": 1.0, "texture": SubResource("anticipation")}, {"duration": 1.0, "texture": SubResource("anticipation")}, {"duration": 1.0, "texture": SubResource("idle")}], "loop": false, "name": &"cast", "speed": 8.0},
