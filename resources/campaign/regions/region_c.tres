choices = Array[ExtResource("stop")]([ExtResource("walk")])
[sub_resource type="Resource" id="stage_3"]
resource_name = "成电会堂商业街"
script = ExtResource("stage")
choices = Array[ExtResource("stop")]([ExtResource("end_c")])
[resource]
resource_name = "第三终端区域"
script = ExtResource("flow")
id = "region_c"
display_name = "第三终端区域"
revision = 1
stages = Array[ExtResource("stage")]([SubResource("stage_0"), SubResource("stage_1"), SubResource("stage_2"), SubResource("stage_3")])
