[ext_resource type="Resource" path="res://resources/campaign/stops/region_c/court.tres" id="court"]
[ext_resource type="Resource" path="res://resources/campaign/stops/region_c/hall.tres" id="hall"]
[ext_resource type="Resource" path="res://resources/campaign/stops/region_c/walk.tres" id="walk"]
[ext_resource type="Resource" path="res://resources/campaign/stops/region_c/end_c.tres" id="end_c"]
[sub_resource type="Resource" id="stage_0"]
resource_name = "南门"
script = ExtResource("stage")
choices = Array[ExtResource("stop")]([ExtResource("gate")])
[sub_resource type="Resource" id="stage_1"]
resource_name = "体育场 / 图书馆"
script = ExtResource("stage")
choices = Array[ExtResource("stop")]([ExtResource("court"), ExtResource("hall")])
[sub_resource type="Resource" id="stage_2"]
