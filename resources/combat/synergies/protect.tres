[gd_resource type="Resource" script_class="CampusSynergy" load_steps=2 format=3]
[ext_resource type="Script" path="res://game/content/synergy_def.gd" id="s"]
[resource]
script = ExtResource("s")
id = "protect"
display_name = "容错工程"
description = "2人激活。开场为前线两名同学各提供20护盾，持续5秒。护盾吸收伤害、产出权限时，为生命比例最低的受伤同学恢复8生命。"
