[gd_resource type="Resource" load_steps=11 format=3]
[ext_resource type="Script" path="res://game/content/code_rules.gd" id="rules"]
[ext_resource type="Script" path="res://game/content/code_program_def.gd" id="program"]
[ext_resource type="Script" path="res://game/content/code_item_def.gd" id="item"]
[sub_resource type="Resource" id="disconnect"]
script = ExtResource("program")
id = "disconnect"
display_name = "追踪破解"
description = "消耗3数据和1指令，对已确认敌人造成45伤害并暴露5秒；各友军首次命中追加一次追击。"
cost = {"blue":3,"red":1}
effect = "pursuit"
[sub_resource type="Resource" id="redirect"]
script = ExtResource("program")
id = "redirect"
display_name = "反冲护盾"
description = "消耗2权限和1协议，全体友军获得30点5秒反冲盾；耗尽或到期产生半径2格的30伤害爆炸。"
cost = {"purple":2,"green":1}
effect = "recoil"
damage = 30.0
[sub_resource type="Resource" id="repair"]
script = ExtResource("program")
id = "repair"
display_name = "热修复"
description = "消耗任意3块代码，恢复一名友军60生命；每场一次。预览可调整支付颜色。"
effect = "repair"
any_cost = 3
per_battle_limit = 1
[sub_resource type="Resource" id="supply"]
script = ExtResource("item")
id = "supply"
display_name = "代码补给"
description = "选择一种代码，立即生成3块。"
effect = "generate"
amount = 3
starting_count = 1
[sub_resource type="Resource" id="converter"]
script = ExtResource("item")
id = "converter"
display_name = "转码器"
description = "将2块同色代码转成另一类型的2块。"
effect = "convert"
amount = 2
starting_count = 1
[sub_resource type="Resource" id="shield"]
script = ExtResource("item")
id = "shield"
display_name = "应急护盾"
description = "为一名存活队员提供120点护盾，持续8秒；实际吸收可产生权限代码。"
effect = "shield"
amount = 120
starting_count = 0
[sub_resource type="Resource" id="revive"]
script = ExtResource("item")
id = "revive"
display_name = "复苏装置"
description = "战斗进行中，令一名倒下的队员以50%生命归队；全队倒下后不可使用。"
effect = "revive"
amount = 50
starting_count = 0
[resource]
script = ExtResource("rules")
types = {
"red":{"name":"指令","symbol":">","color":Color(1,0.43,0.4,1)},
"blue":{"name":"数据","symbol":"{}","color":Color(0.35,0.7,1,1)},
"green":{"name":"协议","symbol":"↔","color":Color(0.4,0.9,0.64,1)},
"purple":{"name":"权限","symbol":"#","color":Color(0.76,0.53,1,1)}
}
programs = Array[Resource]([SubResource("disconnect"),SubResource("redirect"),SubResource("repair")])
items = Array[Resource]([SubResource("supply"),SubResource("converter"),SubResource("shield"),SubResource("revive")])
