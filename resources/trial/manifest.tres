[resource]
script = ExtResource("s")
characters = Array[ExtResource("characters_script")]([ExtResource("characters_guard"), ExtResource("characters_archer"), ExtResource("characters_healer"), ExtResource("characters_analyst"), ExtResource("characters_inventor"), ExtResource("characters_striker")])
synergies = Array[ExtResource("synergies_script")]([ExtResource("synergies_sports"), ExtResource("synergies_broadcast"), ExtResource("synergies_makers"), ExtResource("synergies_protect"), ExtResource("synergies_assault"), ExtResource("synergies_analysis")])
rewards = Array[ExtResource("rewards_script")]([ExtResource("rewards_cover"), ExtResource("rewards_lens"), ExtResource("rewards_training"), ExtResource("rewards_verify"), ExtResource("rewards_pierce"), ExtResource("rewards_backup")])
encounters = Array[ExtResource("encounters_script")]([ExtResource("encounters_stage_1"), ExtResource("encounters_stage_2"), ExtResource("encounters_stage_3")])
