[gd_resource type="Resource" script_class="CampusSkill" load_steps=4 format=3]
[ext_resource type="Script" path="res://game/content/skill_def.gd" id="s"]
[ext_resource type="Script" path="res://game/content/effect_def.gd" id="e"]
[sub_resource type="Resource" id="hit"]
script = ExtResource("e")
