# Additional files that you can ignore: 
# - https://github.com/github/gitignore/blob/master/Godot.gitignore

# Godot-specific ignores
.import/
.godot/

# Python helper caches
__pycache__/
*.py[cod]

# Builds/export directory
builds/**/*
!builds/.gdignore

# Imported translations (automatically generated from CSV files)
*.translation
*.po~
*tmp.mo.*

# OSX 
.DS_Store
