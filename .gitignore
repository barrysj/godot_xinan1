# Additional files that you can ignore: 
# - https://github.com/github/gitignore/blob/master/Godot.gitignore

# Godot-specific ignores
.import/
.godot/
# Codex workflow intermediates belong in .godot/art-workflow/ and are never staged.
# Also ignore legacy workflow directories; delivery previews belong in review/.
**/review/codex-workflow/**
!**/review/codex-workflow/**/
# Existing final demonstration GIFs remain versioned.
!design/concepts/characters/review/codex-workflow/humanoid-release/archer-sonic-ring.gif
!design/concepts/characters/review/codex-workflow/humanoid-release/inventor-sonic-ring.gif
!design/concepts/ui/battlefield/review/codex-workflow/hack-takeover.gif
# Legacy asset QA tools may emit reports next to their inputs.
/design/concepts/**/quality-result.json
/design/concepts/**/asset-validation.json
/design/concepts/**/import-validation.json
/design/concepts/**/delivery-validation.json
/design/concepts/**/validation.json
/assets/art/**/quality-result.json
/assets/art/**/asset-validation.json
/assets/art/**/import-validation.json
/assets/art/**/delivery-validation.json
/assets/art/**/validation.json
# Review evidence is served as source media and is not a runtime Godot resource.
design/concepts/**/review/*.import

# Python helper caches
__pycache__/
*.py[cod]

# Local API credential supplied by the project owner
/api.txt

# Builds/export directory
tools/ToolLauncher.exe.sources
builds/**/*
!builds/.gdignore

# Imported translations (automatically generated from CSV files)
*.translation
*.po~
*tmp.mo.*

# OSX 
.DS_Store

# Art candidates are promoted only at phase closeout.
/design/concepts/**/tmp_[0-9][0-9][0-9]/
/assets/art/**/tmp_[0-9][0-9][0-9]/

# Godot-generated import descriptors and script ID sidecars are local.
*.import
*.uid

# Web-only texture compression is a reproducible release setting.
!assets/art/web_backgrounds/**/*.import
!assets/art/web_campus_map/**/*.import
